# Copy this file to .env and fill in real values. Never commit .env itself.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.as-africa.com

# Leave unset to use local SQLite. On Render/production, set to the
# managed Postgres connection string, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://as-africa.com

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CamPay (MTN MoMo / Orange Money payments)
CAMPAY_ENV=demo
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_SECRET=

# Email (booking/order confirmations) — console backend prints to terminal in dev
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@as-africa.com
VITE_API_URL=http://localhost:8000/api
